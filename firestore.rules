rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getMemberData(sectionId) {
      return get(/databases/$(database)/documents/sections/$(sectionId)/members/$(request.auth.uid)).data;
    }

    function isSectionMember(sectionId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/sections/$(sectionId)/members/$(request.auth.uid));
    }

    function isSectionAdmin(sectionId) {
      return isSectionMember(sectionId) &&
        getMemberData(sectionId).sectionRole in ['sectionManager', 'sectionAdmin', 'owner'];
    }

    function isTripLeader(sectionId) {
      return isSectionMember(sectionId) &&
        getMemberData(sectionId).sectionRole in ['tripLeader', 'sectionManager', 'sectionAdmin', 'owner'];
    }

    // Helper: Check if user is a system-wide global administrator.
    // Admin status lives only in Firebase Auth custom claims (set via the
    // Admin SDK), never in the user document, which the user can write.
    function isGlobalAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Whether an event requires leader approval before a registration is
    // confirmed. Missing field defaults to false (matches the Event model).
    function eventRequiresApproval(sectionId, eventId) {
      return get(/databases/$(database)/documents/sections/$(sectionId)/events/$(eventId)).data.requiresApproval == true;
    }

    // The status a self-registration may start in for this event.
    function isAllowedInitialStatus(sectionId, eventId, status) {
      return eventRequiresApproval(sectionId, eventId)
        ? status in ['pending', 'waitlisted']
        : status == 'approved';
    }


    // --- Collection Rules ---

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isUser(userId);
    }

    // Collection group query for registrations (allows users to query their own registrations)
    match /{path=**}/registrations/{registrationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isGlobalAdmin());
    }

    // Sections collection & subcollections
    match /sections/{sectionId} {
      allow read: if isSignedIn();
       // Global admins can create completely new sections; section admins can update existing ones
      allow create, delete: if isGlobalAdmin();
      allow update: if isSectionAdmin(sectionId) || isGlobalAdmin();
      allow write: if isSectionAdmin(sectionId); // or a global admin check if needed for creation

      match /members/{userId} {
        // Signed-in users may read member lists. Membership gating is enforced
        // by the app (profile completion + section guards). Using
        // isSectionMember() here would be circular (it does an exists()/get()
        // on this same subcollection) and fails on the first rules evaluation.
        allow read: if isSignedIn();
        // Only section admins can write roles, or users removing themselves, or global admins
        allow write: if isSectionAdmin(sectionId) || isUser(userId) || isGlobalAdmin();
      }

      // NOTE (emulator-only): the canRead rules below call isSectionMember()/
      // isTripLeader(), which do an exists()/get() lookup of this section's
      // members subcollection during a rules evaluation. In the Firestore
      // emulator the FIRST evaluation of a Listen (watch target) can
      // transiently miss a committed member document and return a spurious
      // PERMISSION_DENIED; the immediate re-evaluation succeeds. Real Cloud
      // Firestore evaluates get()/exists() against committed data
      // consistently, so this does not occur in production. Do not chase this
      // in the emulator UI's request log -- the error is pre-verified as an
      // emulator quirk (the target doc exists and isGranted the second pass).
      match /events/{eventId} {
        allow read: if isSectionMember(sectionId);
        // Only trip leaders or admins can modify events
        allow write: if isTripLeader(sectionId);

        match /registrations/{registrationId} {
          // Any section member may list the registrations collection (resource.data is
          // null for list queries so the per-doc userId check cannot be applied there).
          allow list: if isSectionMember(sectionId);
          // Single-document reads are restricted to own registration or leader/admin.
          allow get: if isSectionMember(sectionId) && (resource.data.userId == request.auth.uid || isTripLeader(sectionId));

          // Registrations use the member's UID as the document ID, so enforcing
          // registrationId == userId gives at most one registration per member
          // per event. Leaders may register someone else; members may only
          // register themselves.
          allow create: if isSectionMember(sectionId) && (
            (isTripLeader(sectionId)
              && request.resource.data.userId == registrationId
              && request.resource.data.id == registrationId)
            || (request.resource.data.userId == request.auth.uid
              && registrationId == request.auth.uid
              && request.resource.data.id == registrationId
              && isAllowedInitialStatus(sectionId, eventId, request.resource.data.status))
          );

          // Members may:
          //  * edit non-status fields (carpool/guest) without changing status,
          //  * withdraw an active registration,
          //  * re-register after withdrawing.
          // They may never set approved/attended/absent/rejected themselves.
          // Leaders may manage any registration in their section.
          //
          // Capacity (maxParticipants) cannot be enforced in rules (no count
          // aggregation); the client/UI enforces it. See docs/review.md C3.
          allow update: if isSectionMember(sectionId) && (
            isTripLeader(sectionId)
            || (resource.data.userId == request.auth.uid
              && request.resource.data.userId == resource.data.userId
              && request.resource.data.id == resource.data.id
              && (
                // Non-status edits only.
                (request.resource.data.status == resource.data.status
                  && request.resource.data.registeredAt == resource.data.registeredAt
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['guestName', 'isDriver', 'needsRide', 'updatedAt']))
                // Self-withdrawal of an active registration.
                || (request.resource.data.status == 'withdrawn'
                  && resource.data.status in ['pending', 'waitlisted', 'approved']
                  && request.resource.data.registeredAt == resource.data.registeredAt
                  && request.resource.data.withdrawnByUserId == request.auth.uid)
                // Re-register after a previous withdrawal.
                || (resource.data.status == 'withdrawn'
                  && isAllowedInitialStatus(sectionId, eventId, request.resource.data.status))
              ))
          );

          // Members withdraw (soft delete) instead of deleting, so the audit
          // trail (withdrawnByUserId/withdrawnAt) is preserved. Hard deletes
          // are leader-only.
          allow delete: if isSectionMember(sectionId) && isTripLeader(sectionId);
        }
      }
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn() && (resource.data.recipientId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.recipientId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Templates collection
    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Tighten this to a global admin role if required
    }
  }
}
